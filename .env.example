# GitHub Achievement Unlocker configuration
# Copy this file to ".env" and fill in your own values.

# Fine-grained Personal Access Token with "Contents" + "Pull requests"
# read/write permissions on the target repository.
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx

# Your GitHub username (repository owner)
GH_OWNER=your-username

# The (public) repository the bot will operate on
GH_REPO=your-repo

# File to modify on each iteration
GH_FILENAME=README.md

# Base branch to open pull requests against
GH_BASE_BRANCH=main

# Seconds to wait between iterations
GH_INTERVAL=10

# How many pull requests to create/merge before stopping.
# Set to 0 to run forever (Ctrl+C to stop).
GH_ITERATIONS=5

# --- Pair Extraordinaire only ---
# A collaborator on the repo. The email MUST be a verified email of a real
# GitHub account, otherwise the co-author is not credited.
GH_COAUTHOR_NAME=collaborator-username
GH_COAUTHOR_EMAIL=collaborator@example.com
